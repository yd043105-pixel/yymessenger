<Window x:Class="SchoolMessenger.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="여양고등학교 · 온라인 교무실" Width="450" Height="820" MinWidth="380" MinHeight="580" Style="{StaticResource SchoolWindow}" Closing="WindowClosing">
 <Grid Background="White">
  <DockPanel x:Name="Workspace" Visibility="Collapsed">
   <Border DockPanel.Dock="Top" Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,14">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="51"/><ColumnDefinition/><ColumnDefinition Width="53"/></Grid.ColumnDefinitions>
     <Grid Width="39" Height="39" HorizontalAlignment="Left"><Ellipse Fill="#DCE7FF"/><TextBlock x:Name="AvatarInitial" Text="여" Foreground="{StaticResource Blue}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/><Ellipse Width="9" Height="9" Fill="#21B489" Stroke="White" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
     <StackPanel Grid.Column="1"><TextBlock x:Name="IdentityLabel" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="IdentityDepartment" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <Border Grid.Column="2" Background="#E7F9F1" CornerRadius="5" VerticalAlignment="Center" Padding="6,4"><TextBlock Text="접속 중" Foreground="#157F61" FontSize="10" HorizontalAlignment="Center"/></Border>
    </Grid>
   </Border>
   <Border DockPanel.Dock="Bottom" Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="10,7"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ConnectionLabel" Text="서버 연결 확인 중" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock x:Name="RosterHint" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="10" Margin="8,0,0,0"/></Grid>
    <TextBlock x:Name="StatusLabel" Foreground="#AD573C" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <Border DockPanel.Dock="Left" Width="60" Background="{StaticResource Navy}"><DockPanel Margin="0,8">
    <Button DockPanel.Dock="Bottom" ToolTip="설정" Style="{StaticResource RailButton}" Click="OpenSettings"><StackPanel><Path Data="{StaticResource SettingsIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="설정" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel>
     <Button.ContextMenu><ContextMenu><MenuItem x:Name="Quiet" Header="알림 소리 끄기" IsCheckable="True"/><MenuItem x:Name="DoNotDisturb" Header="방해금지" IsCheckable="True"/><MenuItem x:Name="AutoStartMenu" Header="Windows 로그인 시 자동 실행" IsCheckable="True" Checked="StartupChanged" Unchecked="StartupChanged"/><Separator/><MenuItem Header="내 비밀번호 변경" Click="ChangePassword"/><MenuItem x:Name="AdminButton" Header="교직원 · 서버 관리" Click="OpenAdmin" Visibility="Collapsed"/><Separator/><MenuItem Header="로그아웃" Click="Logout"/><MenuItem Header="프로그램 종료" Click="ExitApp"/></ContextMenu></Button.ContextMenu>
    </Button>
    <StackPanel>
     <Button x:Name="OrganizationButton" Style="{StaticResource RailButton}" Background="{StaticResource Blue}" Foreground="White" Click="ShowOrganization"><StackPanel><Path Data="{StaticResource TreeIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="조직도" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Tag="received" Click="OpenMailboxClick"><StackPanel><Path Data="{StaticResource MailIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="받은함" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Tag="unread" Click="OpenMailboxClick"><StackPanel><Path Data="{StaticResource MailIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="미확인" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Tag="sent" Click="OpenMailboxClick"><StackPanel><Path Data="{StaticResource SendIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="보낸함" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
     <Button x:Name="FavoritesButton" Style="{StaticResource RailButton}" Click="ToggleFavorites"><StackPanel><Path Data="{StaticResource StarIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="즐겨찾기" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Click="OpenChatClick"><StackPanel><Path Data="{StaticResource ChatIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="채팅" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Click="OpenSurveyClick"><StackPanel><Path Data="{StaticResource SurveyIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="설문" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Click="OpenWorkClick"><StackPanel><Path Data="{StaticResource FileIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="할 일·제출" FontSize="9" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
    </StackPanel>
   </DockPanel></Border>
   <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,13,12,10"><StackPanel>
     <Grid><TextBox x:Name="PeopleSearch" ToolTip="이름 또는 부서명 검색" TextChanged="SearchPeople" Padding="30,8,8,8"/>
      <Path Data="M10,4 A6,6 0 1 1 9.99,4 M14,14 L19,19" Stroke="#8B9CB3" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False"/>
      <TextBlock Text="이름 또는 부서 검색" Foreground="#9AA7BB" Margin="32,0,0,0" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PeopleSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <DockPanel Margin="0,9,0,0"><Button x:Name="SortButton" DockPanel.Dock="Right" Content="이름순 ↕" FontSize="10" Foreground="{StaticResource Muted}" BorderThickness="0" Padding="4,5" Click="ToggleSort"/><StackPanel Orientation="Horizontal"><Button x:Name="AllFilter" Content="전체" Style="{StaticResource FilterButton}" Click="FilterAll" Background="{StaticResource Pale}" Foreground="{StaticResource Blue}"/><Button x:Name="OnlineFilter" Content="접속 중" Style="{StaticResource FilterButton}" Click="FilterOnline" Margin="6,0,0,0"/></StackPanel></DockPanel>
    </StackPanel></Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,9"><DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="파일" Click="SendFilesClick" FontSize="11" Padding="10,7" Margin="0,0,6,0"/><Button Click="Compose" Style="{StaticResource PrimaryButton}" FontSize="11" Padding="10,7"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource MailIcon}" Style="{StaticResource Glyph}" Width="14" Height="14"/><TextBlock Text="메시지" Margin="6,0,0,0"/></StackPanel></Button></StackPanel>
     <TextBlock x:Name="SelectionHint" Text="선택 0명" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
    </DockPanel></Border>
    <TreeView x:Name="OrganizationTree" Margin="8,9,7,5" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   </DockPanel>
  </DockPanel>
  <Grid x:Name="LoginPanel" Margin="24" VerticalAlignment="Center"><StackPanel>
   <Border Width="45" Height="45" Background="{StaticResource Blue}" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,16"><TextBlock Text="여" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <TextBlock Text="여양 교무실" FontSize="26" FontWeight="Bold"/><TextBlock Text="우리 학교 선생님들의 온라인 교무실" Foreground="{StaticResource Muted}" Margin="0,9,0,26"/>
   <TextBlock Text="학교 서버 주소" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,7"/><TextBox x:Name="ServerAddress" Text="http://localhost:5080"/>
   <TextBlock Text="아이디" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,7"/><TextBox x:Name="UsernameBox"/>
   <TextBlock Text="비밀번호" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,15,0,7"/><PasswordBox x:Name="PasswordBox" KeyDown="PasswordKeyDown"/>
   <CheckBox x:Name="AutoStartCheck" Content="Windows 로그인 시 자동 실행" FontSize="11" Margin="0,17,0,0" Checked="StartupChanged" Unchecked="StartupChanged"/>
   <CheckBox x:Name="RememberLogin" Content="이 Windows 계정에서 자동 로그인" FontSize="11" Margin="0,9,0,0" Checked="RememberChanged" Unchecked="RememberChanged"/>
   <Button x:Name="LoginButton" Content="로그인" Style="{StaticResource PrimaryButton}" Click="LoginClick" Margin="0,19,0,12" Padding="10,11"/>
   <Button Content="처음 사용하시나요? 계정 신청" FontSize="11" BorderThickness="0" Foreground="{StaticResource Blue}" Click="RegisterClick" Padding="7" Margin="0,0,0,9"/>
   <TextBlock x:Name="LoginError" Foreground="#AD573C" TextWrapping="Wrap"/><TextBlock Text="서버 주소는 정보담당 선생님에게 확인하세요." FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/>
  </StackPanel></Grid>
 </Grid>
</Window>
