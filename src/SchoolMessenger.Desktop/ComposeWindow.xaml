<Window x:Class="SchoolMessenger.Desktop.ComposeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="여양 교무실 · 새 메시지" Width="760" Height="640" MinWidth="680" MinHeight="560" Style="{StaticResource SchoolWindow}" WindowStartupLocation="CenterOwner" Closing="WindowClosing">
 <DockPanel Background="White">
  <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="21,16"><StackPanel><TextBlock Text="새 메시지" FontSize="19" FontWeight="Bold"/><TextBlock Text="선생님께 필요한 내용과 자료를 전달하세요." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Soft}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0" Padding="14">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="받는 사람" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/><TextBox x:Name="PeopleSearch" TextChanged="FilterPeople" ToolTip="이름·부서 검색" Padding="7,6"/><CheckBox x:Name="FavoritesOnly" Content="즐겨찾기만 보기" Checked="FilterPeople" Unchecked="FilterPeople" FontSize="11" Margin="0,12,0,14"/>
      <TextBlock Text="부서 전체 수신" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,5"/><ComboBox x:Name="Department" Margin="0,0,0,11" Padding="6" FontSize="11"/><CheckBox x:Name="SendAll" Content="전체 교직원에게 보내기" FontSize="11" Margin="0,0,0,13"/>
     </StackPanel>
     <ListBox x:Name="PeopleList" Background="Transparent"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="2,7"/></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><DockPanel><CheckBox DockPanel.Dock="Right" IsChecked="{Binding Favorite,Mode=TwoWay}" Content="★" Foreground="{StaticResource Blue}" ToolTip="즐겨찾기" Margin="5,0,0,0" FontSize="10"/><CheckBox IsChecked="{Binding Selected,Mode=TwoWay}" Content="{Binding Label}" FontSize="11" ToolTip="{Binding Label}"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <DockPanel Grid.Column="1" Margin="20,17">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="제목" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,7"/><TextBox x:Name="TitleBox" MaxLength="200"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><CheckBox x:Name="CollectFiles" Content="파일 제출 요청" VerticalAlignment="Center" Margin="0,0,12,0"/><DatePicker x:Name="SubmissionDate" Width="140" ToolTip="마감 날짜 · 해당일 23:59까지"/></StackPanel></StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock x:Name="Feedback" Foreground="#A05B24" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,7"/>
     <TextBlock Text="첨부파일은 업로드 후 30일간 보관됩니다." FontSize="10" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
     <DockPanel><Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Send" FontSize="11" Padding="13,8"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SendIcon}" Style="{StaticResource Glyph}" Width="14" Height="14"/><TextBlock Text="보내기" Margin="6,0,0,0"/></StackPanel></Button><Button Content="임시 저장 삭제 · 새로 작성" Click="DiscardDraft" FontSize="10" Padding="8,7" HorizontalAlignment="Left"/></DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,3">
     <DockPanel Margin="0,0,0,7"><Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="선택 제거" Click="RemoveFile" FontSize="10" Padding="7,6"/><Button x:Name="AddButton" Click="AddFiles" FontSize="11" Padding="9,6" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource FileIcon}" Style="{StaticResource Glyph}" Width="13" Height="15"/><TextBlock Text="파일 첨부" Margin="6,0,0,0"/></StackPanel></Button></DockPanel>
     <ListBox x:Name="FilesList" Height="63" DisplayMemberPath="Description" AllowDrop="True" Drop="DropFiles" Background="{StaticResource Soft}"/>
     <TextBlock Text="파일당 100MB · 합계 200MB · 최대 10개" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/>
    </StackPanel>
    <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="20000" AllowDrop="True" PreviewDragOver="FilesDragOver" Drop="DropFiles" Margin="0,13,0,13" Padding="12" VerticalContentAlignment="Top"/>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>
