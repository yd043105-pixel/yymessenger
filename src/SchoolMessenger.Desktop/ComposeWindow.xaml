<Window x:Class="SchoolMessenger.Desktop.ComposeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="여양 교무실 · 메시지 보내기" Width="740" Height="610" MinWidth="640" MinHeight="550" Style="{StaticResource SchoolWindow}" WindowStartupLocation="CenterOwner" Closing="WindowClosing">
 <DockPanel Background="{DynamicResource Surface}" Margin="16,12">
  <StackPanel Visibility="Collapsed"><TextBox x:Name="PeopleSearch"/><CheckBox x:Name="FavoritesOnly"/><ComboBox x:Name="Department"/><CheckBox x:Name="SendAll"/><ListBox x:Name="PeopleList"/></StackPanel>

  <StackPanel DockPanel.Dock="Top">
   <DockPanel Margin="0,0,0,7"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SelfButton" Content="나에게 전송" Click="SendToSelf" FontSize="11" Padding="9,5" Margin="0,0,6,0"/><Button x:Name="RecipientsButton" Content="수신자 추가" Click="ChooseRecipients" FontSize="11" Padding="9,5"/></StackPanel><TextBlock x:Name="RecipientCount" Text="받는 사람" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Soft}" Padding="5"><ScrollViewer Height="84" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="RecipientChips"/></ScrollViewer></Border>
   <DockPanel Margin="0,10,0,7"><TextBlock Text="제목" Width="48" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBox x:Name="TitleBox" MaxLength="200"/></DockPanel>
   <WrapPanel Margin="0,0,0,6"><CheckBox x:Name="CollectFiles" Content="파일 제출 요청" VerticalAlignment="Center" Margin="0,0,10,0"/><DatePicker x:Name="SubmissionDate" Width="135" ToolTip="제출 마감 날짜 · 해당일 23:59까지"/><TextBlock Text="마감일 23:59까지" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/></WrapPanel>
   <WrapPanel Margin="0,0,0,8"><CheckBox x:Name="ScheduleSend" Content="예약 전송" VerticalAlignment="Center" Margin="0,0,10,0" Checked="ScheduleChanged" Unchecked="ScheduleChanged"/><DatePicker x:Name="ScheduleDate" Width="135" IsEnabled="False"/><TextBox x:Name="ScheduleTime" Text="09:00" Width="65" MaxLength="5" Margin="6,0,0,0" IsEnabled="False" ToolTip="한국 시간 · HH:mm"/><TextBlock Text="한국 시간" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0"/></WrapPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="Feedback" Foreground="#A05B24" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,5"/>
   <DockPanel><Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Send" FontSize="12" Padding="15,8" Content="보내기"/><StackPanel Orientation="Horizontal"><Button x:Name="DraftButton" Content="임시저장" Click="SaveDraftClick" FontSize="11" Padding="9,7"/><Button Content="임시저장 삭제" Click="DiscardDraft" FontSize="10" Padding="8,7" Margin="6,0,0,0"/><Button Content="예약 목록" Click="ShowScheduled" FontSize="10" Padding="8,7" Margin="6,0,0,0"/></StackPanel></DockPanel>
   <TextBlock Text="창을 닫아도 자동 임시저장됩니다." Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,5,0,0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,5">
   <DockPanel Margin="0,0,0,6"><Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="선택 제거" Click="RemoveFile" FontSize="10" Padding="7,5"/><Button x:Name="AddButton" Click="AddFiles" Content="파일 첨부" FontSize="11" Padding="9,5" HorizontalAlignment="Left"/></DockPanel>
   <ListBox x:Name="FilesList" Height="54" DisplayMemberPath="Description" AllowDrop="True" Drop="DropFiles" Background="{DynamicResource Soft}"/>
   <TextBlock Text="파일당 100MB · 합계 200MB · 최대 10개 · 업로드 후 30일 보관" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0"/>
  </StackPanel>
  <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="20000" AllowDrop="True" PreviewDragOver="FilesDragOver" Drop="DropFiles" Margin="0,0,0,10" Padding="12" VerticalContentAlignment="Top"/>
 </DockPanel>
</Window>
