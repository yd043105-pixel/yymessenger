<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">net10.0-ios</TargetFrameworks>
        <NuGetLockFilePath Condition="$([MSBuild]::IsOSPlatform('osx'))">packages.ios.lock.json</NuGetLockFilePath>
        <RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('osx'))">ios-arm64;iossimulator-arm64;iossimulator-x64</RuntimeIdentifiers>

		<OutputType>Exe</OutputType>
		<RootNamespace>SchoolMessenger.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<AndroidManifest Condition="'$(Configuration)' == 'Debug'">Platforms/Android/AndroidManifest.Debug.xml</AndroidManifest>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>교무톡</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>kr.school.yeoyang.messenger</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>
        <SchoolApp Condition="'$(SchoolApp)' == '' And '$(Configuration)' == 'Release'">Family</SchoolApp>
		<SchoolApp Condition="'$(SchoolApp)' == ''">Combined</SchoolApp>


		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
	</PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(IosVerification)' == 'true'">
        <DefineConstants>$(DefineConstants);IOS_VERIFY</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SchoolApp)' == 'Teacher'">
        <ApplicationId>kr.school.yeoyang.teacher</ApplicationId>
        <ApplicationTitle>교무톡</ApplicationTitle>
        <DefineConstants>$(DefineConstants);TEACHER_APP</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SchoolApp)' == 'Family'">
        <ApplicationId>kr.school.yeoyang.family</ApplicationId>
        <ApplicationTitle>학교톡</ApplicationTitle>
        <DefineConstants>$(DefineConstants);FAMILY_APP</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'iossimulator-arm64' Or '$(RuntimeIdentifier)' == 'iossimulator-x64'">
        <CodesignEntitlements>Platforms/iOS/Entitlements.Simulator.plist</CodesignEntitlements>
        <CodesignRequireProvisioningProfile>false</CodesignRequireProvisioningProfile>
        <CodesignKey>-</CodesignKey>
    </PropertyGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios' And '$(Configuration)' == 'Debug'">
        <PartialAppManifest Include="Platforms/iOS/Info.Debug.plist" />
        <Compile Include="../../tests/IosRuntimeChecks.cs" Link="IosRuntimeChecks.cs" Condition="'$(IosVerification)' == 'true'" />
    </ItemGroup>

	<ItemGroup>
		<AndroidResource Include="Platforms/Android/Resources/xml/network_security_config.xml" Condition="'$(Configuration)' == 'Debug'" />
		<!-- App Icon -->
		<!-- 교무톡 is blue; 학교톡 (Family) uses the green set with the same file names so platform references stay appicon. -->
		<MauiIcon Condition="'$(SchoolApp)' != 'Family'" Include="../SchoolMessenger.Shared/Branding/appicon.svg" ForegroundFile="../SchoolMessenger.Shared/Branding/appiconfg.svg" Color="#245BC6" />
		<MauiIcon Condition="'$(SchoolApp)' == 'Family'" Include="../SchoolMessenger.Shared/Branding/school/appicon.svg" ForegroundFile="../SchoolMessenger.Shared/Branding/school/appiconfg.svg" Color="#17745D" />

		<!-- Splash Screen -->
		<MauiSplashScreen Condition="'$(SchoolApp)' != 'Family'" Include="../SchoolMessenger.Shared/Branding/appiconfg.svg" Color="#245BC6" BaseSize="128,128" />
		<MauiSplashScreen Condition="'$(SchoolApp)' == 'Family'" Include="../SchoolMessenger.Shared/Branding/school/appiconfg.svg" Color="#17745D" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
        <MauiImage Condition="'$(SchoolApp)' != 'Family'" Include="../SchoolMessenger.Shared/Branding/brand_mark.svg" Link="Resources/Images/brand_mark.svg" BaseSize="128,128" />
        <MauiImage Condition="'$(SchoolApp)' == 'Family'" Include="../SchoolMessenger.Shared/Branding/school/brand_mark.svg" Link="Resources/Images/brand_mark.svg" BaseSize="128,128" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*.ttf" />
		<MauiAsset Include="Resources/Fonts/LICENSE-OpenSans.txt;Resources/Fonts/NOTICE-OpenSans.txt" LogicalName="licenses/%(Filename)%(Extension)" />
        <MauiAsset Include="../../LICENSE;../../THIRD-PARTY-NOTICES.md" LogicalName="licenses/%(Filename)%(Extension)" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<!-- Share the DTO source without inheriting the Windows service runtime graph. -->
    <Compile Include="../SchoolMessenger.Contracts/Announcements.cs" Link="Contracts/Announcements.cs" />
    <Compile Include="../SchoolMessenger.Contracts/Counseling.cs" Link="Contracts/Counseling.cs" />
    <Compile Include="../SchoolMessenger.Contracts/SchoolDay.cs" Link="Contracts/SchoolDay.cs" />
    <Compile Include="../SchoolMessenger.Contracts/Office.cs" Link="Contracts/Office.cs" />
    <Compile Include="../SchoolMessenger.Contracts/MessageFormatting.cs" Link="Contracts/MessageFormatting.cs" />
    <Compile Include="../SchoolMessenger.Contracts/Feedback.cs" Link="Contracts/Feedback.cs" />
    <Compile Include="../SchoolMessenger.Contracts/Electives.cs" Link="Contracts/Electives.cs" />
    <Compile Include="../SchoolMessenger.Contracts/RegistrationPolicies.cs" Link="Contracts/RegistrationPolicies.cs" />
        <Compile Include="../SchoolMessenger.Shared/ReleaseNotice.cs" Link="ReleaseNotice.cs" />
        <EmbeddedResource Include="../SchoolMessenger.Shared/updates.json" LogicalName="SchoolMessenger.UpdateNotes.json" />
		<!-- The installed workload version must not silently change the locked app dependencies. -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

</Project>
