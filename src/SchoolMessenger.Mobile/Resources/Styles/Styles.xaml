<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Style TargetType="Label"><Setter Property="TextColor" Value="#17243B" /><Setter Property="FontSize" Value="14" /></Style>
    <Style TargetType="Button">
        <Setter Property="TextColor" Value="#17243B" /><Setter Property="BackgroundColor" Value="White" /><Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="14,10" /><Setter Property="MinimumHeightRequest" Value="44" /><Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList><VisualStateGroup x:Name="CommonStates"><VisualState x:Name="Normal" /><VisualState x:Name="Disabled"><VisualState.Setters><Setter Property="Opacity" Value="0.45" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateGroupList>
        </Setter>
    </Style>
    <Style TargetType="Entry"><Setter Property="TextColor" Value="#17243B" /><Setter Property="PlaceholderColor" Value="#64748B" /><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="FontSize" Value="14" /><Setter Property="MinimumHeightRequest" Value="44" /></Style>
    <Style TargetType="Editor"><Setter Property="TextColor" Value="#17243B" /><Setter Property="PlaceholderColor" Value="#64748B" /><Setter Property="BackgroundColor" Value="White" /><Setter Property="FontSize" Value="14" /></Style>
    <Style TargetType="Picker"><Setter Property="TextColor" Value="#17243B" /><Setter Property="TitleColor" Value="#64748B" /><Setter Property="FontSize" Value="13" /><Setter Property="MinimumHeightRequest" Value="44" /></Style>
    <Style TargetType="DatePicker"><Setter Property="TextColor" Value="#17243B" /><Setter Property="FontSize" Value="14" /><Setter Property="MinimumHeightRequest" Value="44" /></Style>
    <Style TargetType="CheckBox"><Setter Property="Color" Value="#2563EB" /><Setter Property="MinimumHeightRequest" Value="44" /><Setter Property="MinimumWidthRequest" Value="44" /></Style>
    <Style TargetType="Switch"><Setter Property="OnColor" Value="#DBEAFE" /><Setter Property="ThumbColor" Value="#2563EB" /><Setter Property="MinimumHeightRequest" Value="44" /></Style>
    <Style TargetType="ActivityIndicator"><Setter Property="Color" Value="#2563EB" /></Style>
    <Style TargetType="Page" ApplyToDerivedTypes="True"><Setter Property="BackgroundColor" Value="#F5F7FB" /></Style>
    <Style TargetType="NavigationPage"><Setter Property="BarBackgroundColor" Value="White" /><Setter Property="BarTextColor" Value="#17243B" /><Setter Property="IconColor" Value="#17243B" /></Style>
</ResourceDictionary>